package com.example.androidtemplate

import android.app.Service
import android.content.Intent
import android.graphics.PixelFormat
import android.os.IBinder
import android.view.Gravity
import android.view.View
import android.view.WindowManager
import android.widget.TextView

class FloatingService: Service(){
    override fun onBind(i: Intent?): IBinder?=null
    var v: View?=null
    var wm: WindowManager?=null
    override fun onCreate(){
        super.onCreate()
        wm=getSystemService(WINDOW_SERVICE) as WindowManager
        val tv=TextView(this).apply{text="Real Satisfaction\nWorking!";setPadding(40,40,40,40);setBackgroundColor(-16777216);setTextColor(-1)}
        val p=WindowManager.LayoutParams(-2,-2,WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY,WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE,PixelFormat.TRANSLUCENT)
        p.gravity=Gravity.TOP; p.y=200
        v=tv; wm?.addView(v,p)
    }
    override fun onDestroy(){v?.let{wm?.removeView(it)};super.onDestroy()}
}
