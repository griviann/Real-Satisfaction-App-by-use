package com.example.androidtemplate

import android.content.Intent
import android.os.Bundle
import android.provider.Settings
import androidx.appcompat.app.AppCompatActivity
import android.widget.Button
import android.widget.LinearLayout

class MainActivity : AppCompatActivity() {
    override fun onCreate(b: Bundle?) {
        super.onCreate(b)
        val lay = LinearLayout(this).apply{orientation=LinearLayout.VERTICAL;setPadding(50,150,50,50)}
        val b1 = Button(this).apply{text="Allow Overlay"}
        val b2 = Button(this).apply{text="Start Bubble - Real Satisfaction"}
        b1.setOnClickListener{startActivity(Intent(Settings.ACTION_MANAGE_OVERLAY_PERMISSION))}
        b2.setOnClickListener{startService(Intent(this,FloatingService::class.java))}
        lay.addView(b1); lay.addView(b2); setContentView(lay)
    }
}
